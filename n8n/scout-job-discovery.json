                  {
                      "id":  "code-normalize",
                      "name":  "Normalize \u0026 Deduplicate",
                      "parameters":  {
                                         "jsCode":  "const himalayasData = Fetch Himalayas Jobs.first()?.json?.jobs || [];\nconst arbeitnowData = Fetch Arbeitnow Jobs.first()?.json?.data || [];\nconst remoteokData = Fetch RemoteOK Jobs.first()?.json || [];\n\nconst keywords = [\u0027engineer\u0027, \u0027developer\u0027, \u0027software\u0027, \u0027full stack\u0027, \u0027backend\u0027, \u0027frontend\u0027, \u0027node\u0027, \u0027react\u0027, \u0027python\u0027, \u0027ai\u0027];\nconst results = [];\nconst seenUrls = new Set();\n\n// 1. Process Himalayas\nfor (const job of himalayasData) {\n  const title = (job.title || \u0027\u0027).toLowerCase();\n  if (!keywords.some(kw =\u003e title.includes(kw))) continue;\n\n  const url = job.applicationLink || job.guid;\n  if (!url || seenUrls.has(url)) continue;\n  seenUrls.add(url);\n\n  results.push({\n    json: {\n      title: job.title,\n      company: job.companyName || \u0027Tech Partner\u0027,\n      location: (job.locationRestrictions \u0026\u0026 job.locationRestrictions.length \u003e 0) ? job.locationRestrictions.join(\u0027, \u0027) : \u0027Remote\u0027,\n      salary: job.minSalary \u0026\u0026 job.maxSalary ? $ - {job.maxSalary.toLocaleString()} : \u0027Competitive\u0027,\n      source: \u0027Himalayas\u0027,\n      url: url,\n      description: (job.excerpt || \u0027\u0027).substring(0, 400),\n      posted_at: job.pubDate ? new Date(job.pubDate * 1000).toISOString() : new Date().toISOString(),\n      status: \u0027Discovered\u0027\n    }\n  });\n}\n\n// 2. Process Arbeitnow\nfor (const job of arbeitnowData) {\n  if (job.remote !== true) continue;\n  const title = (job.title || \u0027\u0027).toLowerCase();\n  if (!keywords.some(kw =\u003e title.includes(kw))) continue;\n\n  const url = job.url;\n  if (!url || seenUrls.has(url)) continue;\n  seenUrls.add(url);\n\n  results.push({\n    json: {\n      title: job.title,\n      company: job.company_name,\n      location: job.location || \u0027Remote\u0027,\n      salary: \u0027Competitive\u0027,\n      source: \u0027Arbeitnow\u0027,\n      url: url,\n      description: (job.description || \u0027\u0027).replace(/\u003c[^\u003e]*\u003e?/gm, \u0027\u0027).substring(0, 400),\n      posted_at: job.created_at ? new Date(job.created_at * 1000).toISOString() : new Date().toISOString(),\n      status: \u0027Discovered\u0027\n    }\n  });\n}\n\n// 3. Process RemoteOK (first item in array is API metadata, skip index 0)\nif (Array.isArray(remoteokData) \u0026\u0026 remoteokData.length \u003e 1) {\n  for (let i = 1; i \u003c remoteokData.length; i++) {\n    const job = remoteokData[i];\n    const title = (job.position || \u0027\u0027).toLowerCase();\n    if (!keywords.some(kw =\u003e title.includes(kw))) continue;\n\n    const url = job.url || (job.apply_url ? job.apply_url : null);\n    if (!url || seenUrls.has(url)) continue;\n    seenUrls.add(url);\n\n    results.push({\n      json: {\n        title: job.position,\n        company: job.company || \u0027RemoteOK Partner\u0027,\n        location: job.location || \u0027Remote\u0027,\n        salary: (job.salary_min \u0026\u0026 job.salary_max) ? $ - {job.salary_max.toLocaleString()} : \u0027Competitive\u0027,\n        source: \u0027RemoteOK\u0027,\n        url: url,\n        description: (job.description || \u0027\u0027).replace(/\u003c[^\u003e]*\u003e?/gm, \u0027\u0027).substring(0, 400),\n        posted_at: job.date ? new Date(job.date).toISOString() : new Date().toISOString(),\n        status: \u0027Discovered\u0027\n      }\n    });\n  }\n}\n\nreturn results;"
                                     },
                      "type":  "n8n-nodes-base.code",
                      "position":  [
                                       720,
                                       320
                                   ],
                      "typeVersion":  2
