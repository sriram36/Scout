# ─── AI / LLM ──────────────────────────────────────────────────────────────────
# Scout works with any ONE of these providers. Choose with LLM_PROVIDER, or leave it
# unset and Scout auto-detects (Azure if all three AZURE_* vars are set, otherwise
# the OpenAI-compatible provider if LLM_API_KEY or LLM_BASE_URL is set).
# LLM_PROVIDER=openai

# Option A — Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Option B — any OpenAI-compatible API (OpenAI, Gemini, Groq, Ollama). Examples:
#   OpenAI : LLM_BASE_URL=https://api.openai.com/v1            LLM_MODEL=gpt-4o-mini
#   Gemini : LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   LLM_MODEL=gemini-2.0-flash
#   Groq   : LLM_BASE_URL=https://api.groq.com/openai/v1       LLM_MODEL=llama-3.3-70b-versatile
#   Ollama : LLM_BASE_URL=http://localhost:11434/v1            LLM_MODEL=llama3.1   (no key needed)
# LLM_API_KEY=your_api_key_here
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# ─── Supabase ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Browser key: used by the dashboard (dashboard/.env.local) — read access + queueing only.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Server key: used by the apply server and n8n. SECRET — never expose it to the browser
# and never give it a NEXT_PUBLIC_ name.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ─── n8n (docker compose) ──────────────────────────────────────────────────────
# Encrypts credentials stored by n8n. Generate once with: openssl rand -hex 24
N8N_ENCRYPTION_KEY=change_me_to_a_long_random_string
GENERIC_TIMEZONE=Asia/Kolkata

# ─── Server ─────────────────────────────────────────────────────────────────────
PORT=3001

# ─── Browser ────────────────────────────────────────────────────────────────────
# Set to "true" to force headless mode, "false" to always show browser.
# If unset, auto-detects: headless on cloud/Linux, headed locally.
HEADLESS=false

# ─── Logging ────────────────────────────────────────────────────────────────────
# One of: debug, info, warn, error
LOG_LEVEL=info
NODE_ENV=development

# ─── Profile (alternative to profile.json) ──────────────────────────────────────
# If profile.json doesn't exist, paste your profile JSON here as a single line.
# PROFILE_JSON={"personal":{"firstName":"Jane",...}}
