# ─── AI / LLM ──────────────────────────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# ─── Supabase ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ─── Server ─────────────────────────────────────────────────────────────────────
PORT=3001

# ─── Browser ────────────────────────────────────────────────────────────────────
# Set to "true" to force headless mode, "false" to always show browser.
# If unset, auto-detects: headless on cloud/Linux, headed locally.
HEADLESS=false

# ─── Logging ────────────────────────────────────────────────────────────────────
# One of: debug, info, warn, error
LOG_LEVEL=info
NODE_ENV=development

# ─── Profile (alternative to profile.json) ──────────────────────────────────────
# If profile.json doesn't exist, paste your profile JSON here as a single line.
# PROFILE_JSON={"personal":{"firstName":"Jane",...}}
